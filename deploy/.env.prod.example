# cerbix production secrets — copy to deploy/.env and fill in. NEVER commit deploy/.env.
#   cp deploy/.env.prod.example deploy/.env
#   docker compose --env-file deploy/.env -f deploy/docker-compose.prod.yml up -d --build

# --- Postgres ---
POSTGRES_USER=cerbix
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=cerbix

# --- RabbitMQ ---
RABBITMQ_USER=cerbix
RABBITMQ_PASSWORD=change-me-to-a-strong-password

# --- cerbix ---
# 32-byte base64 key encrypting channel secrets + TOTP at rest.
#   generate:  openssl rand -base64 32
CERBIX_ENCRYPTION_KEY=
# Bootstrap admin (created on first start; change the password after logging in).
CERBIX_ADMIN_EMAIL=admin@example.com
CERBIX_ADMIN_PASSWORD=change-me-to-a-strong-password

# API publish address. Default is localhost-only — front it with a TLS reverse
# proxy. Set to 0.0.0.0:8080 only if you deliberately expose it directly.
CERBIX_HTTP_BIND=127.0.0.1:8080

# Image tag to run. Built locally by `up --build`; pin a registry tag in real prod.
CERBIX_IMAGE=cerbix:latest
