# cerbix production secrets — copy to docker/.env and fill in. NEVER commit docker/.env.
#   cp docker/.env.prod.example docker/.env
#   docker compose --env-file docker/.env -f docker/docker-compose.prod.yml up -d --build

# --- Postgres ---
POSTGRES_USER=cerbix
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=cerbix

# --- RabbitMQ ---
# Required image fence. Fresh deployments start on 4.3; an existing retained
# volume must keep its current image and follow the staged runbook before changing.
CERBIX_RABBITMQ_IMAGE=rabbitmq:4.3-management
RABBITMQ_USER=cerbix
RABBITMQ_PASSWORD=change-me-to-a-strong-password

# --- cerbix ---
# 32-byte base64 key encrypting channel secrets + TOTP at rest.
#   generate:  openssl rand -base64 32
CERBIX_ENCRYPTION_KEY=
# Bootstrap admin (created on first start; change the password after logging in).
CERBIX_ADMIN_EMAIL=admin@example.com
CERBIX_ADMIN_PASSWORD=change-me-to-a-strong-password

# API publish address. Default is localhost-only — front it with a TLS reverse
# proxy. Set to 0.0.0.0:8080 only if you deliberately expose it directly.
CERBIX_HTTP_BIND=127.0.0.1:8080

# Image to run — published to GHCR by the release workflow on v* tags.
# Pin a version in real prod instead of latest, e.g. ghcr.io/teamlead-com/cerbix:v0.1.0.
# While the repository is private, pulling requires `docker login ghcr.io` with a PAT.
CERBIX_IMAGE=ghcr.io/teamlead-com/cerbix:latest
